---
layout: layouts/base.njk
---
{%- macro amountText(parts) -%}
  {%- for part in parts -%}
    {%- if part.amount %}<span data-base-amount="{{ part.amount }}">{{ part.text }}</span>{% else %}{{ part.text }}{% endif -%}
  {%- endfor -%}
{%- endmacro -%}
{#- The recipe page layout, for the Markdown files in src/recept/. Everything it shows is in `recipe`,
    which src/recept/recept.11tydata.js works out from the front matter and the text (lib/recipes.js).
    The recipe pop-up on the other pages fetches these pages and shows their .recipe-view. -#}
  <main id="main" class="wrap recipe-page">
    <a class="text-button recipe-page-back" href="{{ base }}{{ recipe.back.path }}"><i class="fas fa-arrow-left" aria-hidden="true"></i> {{ recipe.back.label }}</a>
    <article class="recipe-view" data-recipe="{{ recipe.id }}">
      <div class="dialog-top cook-art has-photo">
        {%- set srcset = recipe.image | webpSrcset(base) %}
        <img src="{{ base }}{{ recipe.image | webp(1200) }}"
          {%- if srcset %} srcset="{{ srcset }}" sizes="(min-width: 860px) 810px, 100vw"{% endif %} alt="{{ recipe.alt }}" width="1200" height="675" fetchpriority="high">
      </div>
      <div class="dialog-main">
        {#- A cake (lib/cakes.js) also says where it comes from, with its flag, as on its card on tartor.html. #}
        <p class="dialog-kicker"><span class="mini-badge">{{ site.name | upper | escape }} · {{ recipe.badge or 'RECEPT' }}</span>{% if not recipe.badge %}<span>{% for category in recipe.categoryLinks %}<a href="{{ base }}{{ category.path }}">{{ category.label }}</a>{{ ' · ' if not loop.last }}{% endfor %}</span>{% endif %}{% if tarta %}<span class="cake-origin">{% if cakeFlags[tarta.ursprung] %}<img src="{{ base }}assets/icons/flag-{{ cakeFlags[tarta.ursprung] }}.svg" alt="" width="24" height="19">{% endif %}{{ tarta.ursprung }}</span>{% endif %}</p>
        <h1 id="recipe-title" class="recipe-heading">{{ recipe.title }}</h1>
        <p class="dialog-intro">{{ recipe.description }}</p>
        {#- An illustrated icon per fact label, from assets/icons/. Nivå uses the difficulty's icon.
            factIcons has the labels every type
            shares, and typeFactIcons what a Mer än mat type shows instead or has of its own (Odlingstid,
            Väntetid). A label in neither shows without an icon.
            The icon is inside the dt, as a div in a dl may only hold dt and dd. #}
        {%- set factIcons = {
          'Förberedelse': 'cutting-board' if recipe.food else 'bubbles',
          'Tillagning': 'timer',
          'Portioner': 'cutlery',
          'Nivå': recipe.difficultyIcon,
          'Räcker till': 'jam-jar',
          'Verkningstid': 'kitchen-timer'
        } %}
        {%- set typeFactIcons = {
          spa: {
            'Verkningstid': 'hourglass',
            'Räcker till': 'face-mask-jar'
          },
          household: {
            'Förberedelse': 'vinegar-and-baking-soda',
            'Verkningstid': 'hourglass',
            'Räcker till': 'bucket-with-suds'
          },
          pets: {
            'Förberedelse': 'mixing-bowl-and-whisk',
            'Verkningstid': 'hourglass',
            'Räcker till': 'dog-food'
          },
          garden: {
            'Förberedelse': 'gardening-gloves',
            'Odlingstid': 'sprout',
            'Väntetid': 'hourglass',
            'Vattnar sig själv i': 'watering-can-1',
            'Räcker till': 'windowsill-herbs'
          }
        } %}
        {%- set ownFactIcons = typeFactIcons[recipe.type] or {} %}
        <dl class="recipe-facts">
          {%- for label, value in recipe.facts %}
          <div>
            {%- set scalable = label == recipe.servingsLabel and recipe.servings %}
            {%- set factIcon = ownFactIcons[label] or factIcons[label] %}
            <dt{% if scalable %} id="recipe-servings-label"{% endif %}>{% if factIcon %}<img src="{{ base }}assets/icons/{{ factIcon }}.svg" alt="" width="44" height="44">{% endif %}{{ label }}</dt>
            <dd>
              {%- if scalable %}
              {%- set stepNoun = 'portionerna' if label == 'Portioner' else 'mängden' %}
              {#- Without JavaScript the box shows the value as written, like the others. With it, that
                  gives way to a stepper, − number +, which scales the ingredient amounts. -#}
              <span data-servings-fallback>{{ value | keepRanges }}</span>
              <span class="recipe-servings-stepper" hidden>
                <button class="recipe-servings-step" type="button" data-servings-step="down" aria-label="Minska {{ stepNoun }}"></button>
                <input class="recipe-servings-input" type="number" min="0.5" step="0.5" value="{{ recipe.servings.value }}" inputmode="decimal" aria-labelledby="recipe-servings-label" aria-describedby="recipe-servings-help">
                <button class="recipe-servings-step" type="button" data-servings-step="up" aria-label="Öka {{ stepNoun }}"></button>
              </span>
              <span id="recipe-servings-help" class="sr-only">Ändra värdet för att räkna om mängderna i ingredienslistan.</span>
              {%- else %}
              {{ value | keepRanges }}
              {%- endif %}
            </dd>
          </div>
          {%- endfor %}
        </dl>
        <ul class="recipe-tags" aria-label="Taggar">{% for tag in recipe.tagLinks %}<li><a href="{{ base }}{{ tag.path }}">{{ tag.label }}</a></li>{% endfor %}</ul>
        {%- if recipe.beforeYouStart %}
        <p class="recipe-tip"><b>Bra att veta.</b> {{ recipe.beforeYouStart }}</p>
        {%- endif %}
        <section class="recipe-section" aria-labelledby="ingredients-heading">
          <div class="recipe-section-heading">
            <h2 id="ingredients-heading" class="cook-ingredient-heading"><img src="{{ base }}assets/icons/clipboard-2.svg" alt="" width="24" height="24">Det här behöver du</h2>
            <div class="recipe-actions">
              <button class="text-button" type="button" data-save="{{ recipe.id }}" aria-pressed="false"><span>Spara {{ recipe.noun }}</span><i class="far fa-heart" aria-hidden="true"></i></button>
              <button class="text-button" type="button" data-share-recipe="{{ (site.absolute(page.url) or '') | escape }}" hidden><span>Dela {{ recipe.noun }}</span><i class="far fa-arrow-up-right-from-square" aria-hidden="true"></i></button>
            </div>
          </div>
          <p class="meta recipe-share-status" data-recipe-share-status role="status"></p>
          <input class="recipe-share-link" type="url" data-recipe-share-link aria-label="Länk att dela" readonly hidden>
          {%- if recipe.pantryKeys.length %}
          <div class="cook-pantry" hidden>
            <div>
              <span class="eyebrow">JÄMFÖRT MED DIN KYL</span>
              <strong class="cook-pantry-summary" role="status"></strong>
            </div>
            <button class="button cook-add-missing" type="button" hidden></button>
          </div>
          {%- endif %}
          <div class="cook-checklist">
            <progress class="cook-progress" aria-label="Avbockade råvaror" value="0" max="{{ recipe.ingredientCount }}"></progress>
            <p class="meta cook-progress-text" aria-live="polite">0 av {{ recipe.ingredientCount }} avbockade</p>
          </div>
          <div class="cook-shopping">
            <p>Tryck på + vid det du behöver köpa.</p>
            <button class="text-button cook-open-shopping" type="button" aria-haspopup="dialog"><img src="{{ base }}assets/icons/shopping-basket.svg" alt="" width="20" height="20">Inköpslista <span class="count cook-shopping-count">0</span></button>
          </div>
          <p class="meta" data-servings-note hidden>Ingredienslistan är omräknad. Mängder i instruktionerna gäller originalreceptet.</p>
          <div class="cook-ingredient-columns">
            {%- for group in recipe.ingredientGroups %}
            <div class="ingredient-group">
              {%- if group.title %}
              <h3>{{ group.title }}</h3>
              {%- endif %}
              <ul class="ingredients">
                {%- for item in group.items %}
                {%- if item.note %}
                <li class="ingredient-note">{{ item.name }}</li>
                {%- else %}
                <li class="cook-ingredient"{% if item.key %} data-key="{{ item.key }}"{% endif %}{% if item.basic %} data-basic{% endif %}>
                  <label><input type="checkbox"><span data-ingredient-name>{{ amountText(item.amountParts) }}</span></label>
                  <div class="cook-ingredient-actions">
                    <span class="ingredient-status" hidden></span>
                    <button class="shopping-add" type="button" data-shopping-ingredient="{{ item.shoppingId }}" data-shopping-text="{{ item.name }}" aria-label="{{ item.name }} på inköpslistan" aria-pressed="false"><i class="fas fa-plus" aria-hidden="true"></i></button>
                  </div>
                </li>
                {%- endif %}
                {%- endfor %}
              </ul>
            </div>
            {%- endfor %}
          </div>
          <p class="sr-only" data-servings-status role="status"></p>
        </section>
        <section class="recipe-section recipe-directions" aria-labelledby="directions-heading">
          <h2 id="directions-heading">Gör så här</h2>
          {%- for section in recipe.directionSections %}
          {%- if section.title %}
          <h3>{{ section.title }}</h3>
          {%- endif %}
          <ol class="directions">{% for step in section.steps %}<li>{{ step.html | safe }}</li>{% endfor %}</ol>
          {%- endfor %}
          {%- for note in recipe.directionNotes %}
          <p class="recipe-tip"><b>{{ note.title }}</b> {{ note.html | safe }}</p>
          {%- endfor %}
        </section>
        {#- A pasta dough's recipe lists the sorts that link to it (lib/pasta.js), each with its drawing,
            like "Byt mot" on a sort's page. In the dialog the address is this page's (app.js), so the
            links resolve from recept/ there too. #}
        {%- set madeWith = collections.pastas | pastasMadeWith(recipe.id) %}
        {%- if madeWith.length %}
        <section class="recipe-pastas" aria-labelledby="pastas-heading">
          <h2 id="pastas-heading">Sorter att göra av degen</h2>
          <ul class="pasta-links pasta-swaps">
            {%- for item in madeWith %}
            <li><a href="{{ base }}pasta/{{ item.fileSlug }}.html"><img src="{{ base }}assets/icons/pasta/{{ item.fileSlug }}.svg" alt="" width="40" height="40">{{ item.data.namn }}</a></li>
            {%- endfor %}
          </ul>
        </section>
        {%- endif %}
        {#- A cake part's base recipe lists the cakes built with it (lib/cakes.js), each with the drawing of
            a piece, like the pasta sorts above. They are recipes too, so in the dialog a link opens that
            cake there. #}
        {%- set cakesWith = collections.cakes | cakesMadeWith(recipe.id) %}
        {%- if cakesWith.length %}
        <section class="recipe-pastas recipe-cakes" aria-labelledby="cakes-heading">
          <h2 id="cakes-heading">Tårtor att bygga på dem</h2>
          <ul class="pasta-links pasta-swaps">
            {%- for item in cakesWith %}
            <li><a href="{{ base }}recept/{{ item.fileSlug }}.html" data-open="{{ item.fileSlug }}"><img src="{{ base }}assets/icons/tartor/{{ item.fileSlug }}-bit.svg" alt="" width="40" height="40">{{ item.data.tarta.namn }}</a></li>
            {%- endfor %}
          </ul>
        </section>
        {%- endif %}
        {%- for section in recipe.extraSections %}
        <section class="recipe-extra">
          <h2>{{ section.title }}</h2>
          <ul role="list">{% for item in section.items %}<li>{{ item.html | safe }}</li>{% endfor %}</ul>
        </section>
        {%- endfor %}
        {%- if not recipe.badge %}
        <details class="recipe-measurements">
          <summary>Mått och ugnstemperaturer<i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
          <p>Måtten är svenska (dl, msk, tsk, krm). Ugnstemperaturerna gäller vanlig ugn med över- och undervärme; med varmluft, sänk med 20 grader.</p>
        </details>
        {%- endif %}
        {#- A cake (lib/cakes.js): its place among the cakes on tartor.html, with the drawing of a piece
            (its card there has the whole cake). Each part it is built with links to the cakes that share it (tartor.html?del=), and the
            cakes before and after it open in the dialog when it is one, like the list above. #}
        {%- if tarta %}
        {%- set nearby = collections.cakes | cakeNeighbours(recipe.id) %}
        <section class="cake-place" aria-labelledby="cake-place-heading">
          <img class="cake-place-art" src="{{ base }}assets/icons/tartor/{{ recipe.id }}-bit.svg" alt="" width="160" height="160" loading="lazy">
          <div class="cake-place-text">
            <h2 id="cake-place-heading">Tårta nr {{ tarta.nr }} av {{ collections.cakes.length }}</h2>
            {%- if tarta.delar.length %}
            <p>Fler tårtor byggda med</p>
            <ul class="cake-place-parts">
              {%- for part in tarta.delar %}
              <li><a href="{{ base }}tartor.html?del={{ part }}"><img src="{{ base }}assets/icons/{{ cakeParts[part].icon }}.svg" alt="" width="24" height="24">{{ cakeParts[part].label }}</a></li>
              {%- endfor %}
            </ul>
            {%- endif %}
          </div>
          <nav class="cake-place-nav" aria-label="Fler tårtor">
            {%- if nearby.previous %}
            <a class="text-button" href="{{ base }}recept/{{ nearby.previous.fileSlug }}.html" data-open="{{ nearby.previous.fileSlug }}" rel="prev"><i class="fas fa-arrow-left" aria-hidden="true"></i> {{ nearby.previous.data.tarta.namn }}</a>
            {%- endif %}
            <a class="text-button cake-place-all" href="{{ base }}tartor.html">Alla tårtor</a>
            {%- if nearby.next %}
            <a class="text-button cake-place-next" href="{{ base }}recept/{{ nearby.next.fileSlug }}.html" data-open="{{ nearby.next.fileSlug }}" rel="next">{{ nearby.next.data.tarta.namn }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            {%- endif %}
          </nav>
        </section>
        {%- endif %}
      </div>
    </article>
  </main>
