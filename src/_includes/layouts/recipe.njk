---
layout: layouts/base.njk
---
{%- macro amountText(parts) -%}
  {%- for part in parts -%}
    {%- if part.amount %}<span data-base-amount="{{ part.amount }}">{{ part.text }}</span>{% else %}{{ part.text }}{% endif -%}
  {%- endfor -%}
{%- endmacro -%}
{#- The recipe page layout, for the Markdown files in src/recept/. Everything it shows is in `recipe`,
    which src/recept/recept.11tydata.js works out from the front matter and the text (lib/recipes.js).
    The recipe pop-up on the other pages fetches these pages and shows their .recipe-view. -#}
  <main id="main" class="wrap recipe-page">
    <a class="text-button recipe-page-back" href="{{ base }}{{ recipe.back.path }}"><i class="fas fa-arrow-left" aria-hidden="true"></i> {{ recipe.back.label }}</a>
    <article class="recipe-view" data-recipe="{{ recipe.id }}">
      <div class="dialog-top cook-art has-photo">
        <img src="{{ base }}{{ recipe.image }}"
          {%- if recipe.cardImage %} srcset="{{ base }}{{ recipe.cardImage }} 600w, {{ base }}{{ recipe.image }} 1200w" sizes="(min-width: 860px) 810px, 100vw"{% endif %} alt="{{ recipe.alt }}" width="1200" height="675" fetchpriority="high">
      </div>
      <div class="dialog-main">
        <p class="dialog-kicker"><span class="mini-badge">RESTFEST · {{ recipe.badge or 'RECEPT' }}</span>{% if not recipe.badge %}<span>{% for category in recipe.categoryLinks %}<a href="{{ base }}{{ category.path }}">{{ category.label }}</a>{{ ' · ' if not loop.last }}{% endfor %}</span>{% endif %}</p>
        <h1 id="recipe-title" class="recipe-heading">{{ recipe.title }}</h1>
        <p class="dialog-intro">{{ recipe.description }}</p>
        {#- An illustrated icon per fact label, from assets/icons/. These six are every label the recipes use;
            a new label shows without one. Mer än mat (not recipe.food) has its own icons for Förberedelse and Nivå.
            The icon is inside the dt, as a div in a dl may only hold dt and dd. #}
        {%- set factIcons = {
          'Förberedelse': 'prep-time' if recipe.food else 'bubbles-and-sparkles',
          'Tillagning': 'cook-time',
          'Portioner': 'serves',
          'Nivå': 'difficulty-level' if recipe.food else 'difficulty-level-pink',
          'Räcker till': 'glass-jar',
          'Verkningstid': 'kitchen-timer'
        } %}
        <dl class="recipe-facts">
          {%- for label, value in recipe.facts %}
          <div>
            {%- set scalable = label == recipe.servingsLabel and recipe.servings %}
            <dt{% if scalable %} id="recipe-servings-label"{% endif %}>{% if factIcons[label] %}<img src="{{ base }}assets/icons/{{ factIcons[label] }}.svg" alt="" width="44" height="44">{% endif %}{{ label }}</dt>
            <dd>
              {%- if scalable %}
              {%- set stepNoun = 'portionerna' if label == 'Portioner' else 'mängden' %}
              {#- Without JavaScript the box shows the value as written, like the others. With it, that
                  gives way to a stepper, − number +, which scales the ingredient amounts. -#}
              <span data-servings-fallback>{{ value | keepRanges }}</span>
              <span class="recipe-servings-stepper" hidden>
                <button class="recipe-servings-step" type="button" data-servings-step="down" aria-label="Minska {{ stepNoun }}"></button>
                <input class="recipe-servings-input" type="number" min="0.5" step="0.5" value="{{ recipe.servings.value }}" inputmode="decimal" aria-labelledby="recipe-servings-label" aria-describedby="recipe-servings-help">
                <button class="recipe-servings-step" type="button" data-servings-step="up" aria-label="Öka {{ stepNoun }}"></button>
              </span>
              <span id="recipe-servings-help" class="sr-only">Ändra värdet för att räkna om mängderna i ingredienslistan.</span>
              {%- else %}
              {{ value | keepRanges }}
              {%- endif %}
            </dd>
          </div>
          {%- endfor %}
        </dl>
        <ul class="recipe-tags" aria-label="Taggar">{% for tag in recipe.tagLinks %}<li><a href="{{ base }}{{ tag.path }}">{{ tag.label }}</a></li>{% endfor %}</ul>
        {%- if recipe.beforeYouStart %}
        <p class="recipe-tip"><b>Bra att veta.</b> {{ recipe.beforeYouStart }}</p>
        {%- endif %}
        <section class="recipe-section" aria-labelledby="ingredients-heading">
          <div class="recipe-section-heading">
            <h2 id="ingredients-heading" class="cook-ingredient-heading"><img src="{{ base }}assets/icons/clipboard-2.svg" alt="" width="24" height="24">Det här behöver du</h2>
            <button class="dialog-save" type="button" data-save="{{ recipe.id }}" aria-pressed="false"><i class="far fa-heart" aria-hidden="true"></i>Spara {{ recipe.noun }}</button>
          </div>
          {%- if recipe.pantryKeys.length %}
          <div class="cook-pantry" hidden>
            <div>
              <span class="eyebrow">JÄMFÖRT MED DIN KYL</span>
              <strong class="cook-pantry-summary" role="status"></strong>
            </div>
            <button class="button cook-add-missing" type="button" hidden></button>
          </div>
          {%- endif %}
          <div class="cook-checklist">
            <progress class="cook-progress" aria-label="Avbockade råvaror" value="0" max="{{ recipe.ingredientCount }}"></progress>
            <p class="meta cook-progress-text" aria-live="polite">0 av {{ recipe.ingredientCount }} avbockade</p>
          </div>
          <div class="cook-shopping">
            <p>Tryck på + vid det du behöver köpa.</p>
            <button class="text-button cook-open-shopping" type="button" aria-haspopup="dialog"><img src="{{ base }}assets/icons/shopping-basket-1.svg" alt="" width="20" height="20">Inköpslista <span class="count cook-shopping-count">0</span></button>
          </div>
          <p class="meta" data-servings-note hidden>Ingredienslistan är omräknad. Mängder i instruktionerna gäller originalreceptet.</p>
          <div class="cook-ingredient-columns">
            {%- for group in recipe.ingredientGroups %}
            <div class="ingredient-group">
              {%- if group.title %}
              <h3>{{ group.title }}</h3>
              {%- endif %}
              <ul class="ingredients">
                {%- for item in group.items %}
                {%- if item.note %}
                <li class="ingredient-note">{{ item.name }}</li>
                {%- else %}
                <li class="cook-ingredient"{% if item.key %} data-key="{{ item.key }}"{% endif %}{% if item.basic %} data-basic{% endif %}>
                  <label><input type="checkbox"><span data-ingredient-name>{{ amountText(item.amountParts) }}</span></label>
                  <div class="cook-ingredient-actions">
                    <span class="ingredient-status" hidden></span>
                    <button class="shopping-add" type="button" data-shopping-ingredient="{{ item.shoppingId }}" data-shopping-text="{{ item.name }}" aria-label="{{ item.name }} på inköpslistan" aria-pressed="false"><i class="fas fa-plus" aria-hidden="true"></i></button>
                  </div>
                </li>
                {%- endif %}
                {%- endfor %}
              </ul>
            </div>
            {%- endfor %}
          </div>
          <p class="sr-only" data-servings-status role="status"></p>
        </section>
        <section class="recipe-section recipe-directions" aria-labelledby="directions-heading">
          <h2 id="directions-heading">Gör så här</h2>
          {%- for section in recipe.directionSections %}
          {%- if section.title %}
          <h3>{{ section.title }}</h3>
          {%- endif %}
          <ol class="directions">{% for step in section.steps %}<li>{{ step.html | safe }}</li>{% endfor %}</ol>
          {%- endfor %}
          {%- for note in recipe.directionNotes %}
          <p class="recipe-tip"><b>{{ note.title }}</b> {{ note.html | safe }}</p>
          {%- endfor %}
        </section>
        {%- for section in recipe.extraSections %}
        <section class="recipe-extra">
          <h2>{{ section.title }}</h2>
          <ul role="list">{% for item in section.items %}<li>{{ item.html | safe }}</li>{% endfor %}</ul>
        </section>
        {%- endfor %}
        {%- if not recipe.badge %}
        <details class="recipe-measurements">
          <summary>Mått och ugnstemperaturer<i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
          <p>Måtten är svenska (dl, msk, tsk, krm). Ugnstemperaturerna gäller vanlig ugn med över- och undervärme; med varmluft, sänk med 20 grader.</p>
        </details>
        {%- endif %}
      </div>
    </article>
  </main>
