{#- The layout every page shares: head, header, footer, shopping list and scripts.
    Small UI icons (arrows, chevrons, close, the save heart) come from icons.css: see tools/icons.mjs.
    Page data it reads:
      title, description   <title> and meta description
      titleSuffix          added after the title, e.g. " · Ofta bra efter" on recipe pages
      base                 "../" for pages one folder down (recept/, kategori/, …), so paths resolve from the site root
      scripts              extra scripts from js/ after app.js, e.g. [kitchen.js] on the home page
      modules              extra scripts from js/ loaded as modules, after the others, e.g. [new-recipe.js]
      noindex              true keeps search engines away, e.g. on nytt-recept.html
      recipe               set on recipe pages, which get share tags and recipe structured data
    The address of the AI functions (_data/ai.js) goes in <meta name="restfest-ai"> once it's set. -#}
{%- set isHome = page.url == '/' -%}
{#- The home page links to its own sections; the other pages link to the home page. -#}
{%- set homeUrl = '' if isHome else (base or './') -%}
{#- The "Recept" menu, in the header (opens downwards) and the footer (opens upwards): one entry per
    recipe type, from `menu` in lib/taxonomy.js. It is a <details>, so it opens without JavaScript;
    app.js closes it on Escape, on a click outside and when focus leaves it. The word is marked as
    the current page on every page that lists recipes. -#}
{%- set inRecipes = page.url == '/receptarkiv.html' or page.url == '/mer-an-mat.html' or page.url.startsWith('/typ/') or page.url.startsWith('/kategori/') or page.url.startsWith('/tagg/') -%}
{%- macro recipeMenu(types, base, url, current, icon) %}
        <details class="nav-menu">
          <summary class="nav-link{% if current %} is-current{% endif %}">{% if icon %}<img src="{{ base }}assets/icons/recipes.svg" alt="" width="20" height="20">{% endif %}<span>Recept</span><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
          <ul class="nav-menu-panel">
            {%- for type in types %}
            <li><a href="{{ base }}{{ type.menu.path }}" data-type="{{ type.key }}"{% if url == '/' + type.menu.path %} aria-current="page"{% endif %}><img src="{{ base }}assets/icons/{{ type.icon }}.svg" alt="" width="32" height="32"><span><strong>{{ type.menu.label }}</strong><small>{{ type.menu.note }}</small></span></a></li>
            {%- endfor %}
          </ul>
        </details>
{%- endmacro -%}
<!doctype html>
<html lang="sv"{% if base %} data-base="{{ base }}"{% endif %}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  <title>{{ title }}{{ titleSuffix }}</title>
  <meta name="description" content="{{ description }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {%- if ai.functionsUrl %}
  <meta name="restfest-ai" content="{{ ai.functionsUrl }}">
  {%- endif %}
  {%- if recipe %}
  {%- if recipe.url %}
  <link rel="canonical" href="{{ recipe.url }}">
  <meta property="og:url" content="{{ recipe.url }}">
  {%- endif %}
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Ofta bra efter">
  <meta property="og:title" content="{{ recipe.title }}">
  <meta property="og:description" content="{{ recipe.description }}">
  {%- if recipe.imageUrl %}
  <meta property="og:image" content="{{ recipe.imageUrl }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- endif %}
  {%- endif %}
  <link rel="icon" href="{{ base }}assets/favicon.png" type="image/png">
  <link rel="preload" href="{{ base }}assets/fonts/GTMaru-VF.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ base }}assets/fonts/GTMaruMono-VF.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ base }}css/styles.css">
  <link rel="stylesheet" href="{{ base }}css/icons.css">
  <link rel="stylesheet" href="{{ base }}css/kitchen.css">
  {%- if recipe.structuredData %}
  <script type="application/ld+json">{{ recipe.structuredData | safe }}</script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Hoppa till innehåll</a>
  <header class="site-header">
    <div class="header-inner wrap">
      <a class="brand" href="{{ homeUrl or '#' }}" aria-label="Ofta bra efter, startsida">
        <img src="{{ base }}assets/illustrations/ramen-bowl.svg" width="38" height="38" alt="">
        <span>Ofta bra efter</span>
      </a>
      <nav aria-label="Huvudmeny">
        {{- recipeMenu(collections.recipeTypes, base, page.url, inRecipes, true) }}
        <a class="nav-link" href="{{ homeUrl }}#sa-funkar-det"><img src="{{ base }}assets/icons/information-symbol.svg" alt="" width="20" height="20">Så funkar det</a>
      </nav>
      <div class="header-actions">
        <a class="saved-nav" href="{{ base }}receptarkiv.html?vy=sparade" aria-label="Visa sparade recept">
          <img src="{{ base }}assets/icons/heart.svg" alt="" width="24" height="24">
          <span class="saved-label">Sparat</span>
          <span id="saved-count" class="count">0</span>
        </a>
        <button id="shopping-nav" class="saved-nav" type="button" aria-label="Visa inköpslistan" aria-haspopup="dialog">
          <img src="{{ base }}assets/icons/shopping-basket-1.svg" alt="" width="24" height="24">
          <span class="shopping-nav-label">Inköpslista</span><span id="shopping-count" class="count" aria-hidden="true">0</span>
        </button>
      </div>
    </div>
  </header>

{{ content | safe }}

  {#- The footer is the header turned over: the same rule, brand and menu, with the tagline where the
      header has its buttons. Its "Recept" menu opens upwards.
      Below them the name in large yellow type, cut off by the bottom of the page. It is decoration,
      so screen readers skip it. #}
  <footer class="site-footer">
    <div class="footer-inner wrap">
      <a class="brand" href="{{ homeUrl or '#' }}" aria-label="Ofta bra efter, startsida">
        <img src="{{ base }}assets/illustrations/ramen-bowl.svg" width="38" height="38" alt="">
        <span>Ofta bra efter</span>
      </a>
      <p class="footer-tagline">Rädda resterna.</p>
      <nav aria-label="Sidfot">
        {{- recipeMenu(collections.recipeTypes, base, page.url, inRecipes, false) }}
        <a class="nav-link" href="{{ homeUrl }}#sa-funkar-det">Så funkar det</a>
      </nav>
    </div>
    <p class="footer-mark" aria-hidden="true">Ofta bra efter</p>
  </footer>
  {%- if not recipe %}
  {#- Recipe pages show the recipe in the page, so only the other pages need the recipe pop-up. #}
  <dialog id="recipe-dialog" aria-labelledby="recipe-title"><button class="dialog-close" type="button" aria-label="Stäng recept"><i class="fas fa-xmark" aria-hidden="true"></i></button><div id="dialog-content"></div></dialog>
  {%- endif %}
  <dialog id="shopping-dialog" aria-labelledby="shopping-title">
    <div class="dialog-main">
      <button class="dialog-close" type="button" aria-label="Stäng inköpslistan" autofocus><i class="fas fa-xmark" aria-hidden="true"></i></button>
      <h2 id="shopping-title"><img src="{{ base }}assets/icons/shopping-basket-1.svg" alt="" width="30" height="30">Inköpslista</h2>
      <p id="shopping-empty" class="dialog-intro">Listan är tom. Lägg till det du behöver köpa från ett recept.</p>
      <ul id="shopping-items" class="ingredients"></ul>
    </div>
  </dialog>
  <div id="toast" class="toast" role="status" hidden></div>
  <script src="{{ base }}data/recipe-index.js"></script>
  <script src="{{ base }}js/recipes.js"></script>
  <script src="{{ base }}js/app.js"></script>
  {%- for script in scripts %}
  <script src="{{ base }}js/{{ script }}"></script>
  {%- endfor %}
  {%- for module in modules %}
  <script type="module" src="{{ base }}js/{{ module }}"></script>
  {%- endfor %}
</body>
</html>
