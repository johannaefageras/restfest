---js
// receptbok.html: a signed-in visitor's recipe book: the recipes they generated and the archive
// recipes they hearted, newest first. Built only when the site has accounts (accountPages in
// eleventy.config.js). src/js/recipe-book.js fetches and draws it; HANDOFF.md, "Konton och receptbok".
const layout = 'layouts/base.njk';
const title = 'Min receptbok · Ofta bra efter';
const description = 'Din egen receptbok hos Ofta bra efter: recept du har hittat på och recept du har sparat.';
const noindex = true;
const modules = ['recipe-book.js'];
const permalink = 'receptbok.html';
---
  <main id="main" class="wrap account-page account-dashboard archive-page book-page">
    <section class="account-card" aria-labelledby="book-title">
      <section class="greeting archive-greeting" aria-labelledby="book-title">
        <div>
          <h1 id="book-title"><span class="marker">Min receptbok.</span></h1>
          <p class="greeting-intro when-signed-in">Recept du har hittat på och recept du har sparat ur arkivet, samlade på ett ställe.</p>
          <p class="greeting-intro when-signed-out">Logga in för att se din receptbok.</p>
        </div>
        <div class="greeting-aside" aria-hidden="true">
          <div class="doodle-lineup"><img src="assets/icons/cook-book.svg" alt="" width="60" height="60"></div>
        </div>
      </section>

      <div class="when-signed-in">
        {%- set current = 'receptbok' %}
        {% include "account-nav.njk" %}
        <div class="book-toolbar" data-book-toolbar hidden>
          <div class="food-filters book-filter" role="group" aria-label="Visa">
            <button class="food-filter" type="button" data-book-filter="alla" aria-pressed="true"><img src="assets/icons/cook-book.svg" alt="" width="22" height="22">Alla</button>
            <button class="food-filter" type="button" data-book-filter="egna" aria-pressed="false"><img src="assets/icons/magic-wand.svg" alt="" width="22" height="22">Egna recept</button>
            <button class="food-filter" type="button" data-book-filter="arkiv" aria-pressed="false"><img src="assets/icons/recipe-archive-box.svg" alt="" width="22" height="22">Från arkivet</button>
          </div>
          <a class="text-button" href="./#borja">Hitta på ett recept <i class="fas fa-arrow-up-right" aria-hidden="true"></i></a>
        </div>
        <p class="account-status book-status" role="status" data-book-status>Hämtar receptboken …</p>
        <div class="recipe-grid" data-book-grid></div>
        <section class="book-empty" data-book-empty aria-labelledby="book-empty-title" hidden>
          <div class="step-heading">
            <div><p class="eyebrow">Inga recept än</p><h2 id="book-empty-title">Här börjar din receptbok.</h2></div>
          </div>
          <div class="book-start-grid">
            <div class="add-card book-start-card">
              <img src="assets/icons/magic-wand.svg" alt="" width="48" height="48">
              <h3>Hitta på något nytt</h3>
              <p class="card-intro">Utgå från det du har hemma, så hittar vi på ett recept åt dig. Det sparas här i din receptbok.</p>
              <a class="button primary" href="./#borja">Till kylskåpet <i class="fas fa-arrow-up-right" aria-hidden="true"></i></a>
            </div>
            <div class="photo-card book-start-card">
              <img src="assets/icons/heart.svg" alt="" width="48" height="48">
              <h3>Samla dina favoriter</h3>
              <p class="card-intro">Hittat något gott i receptarkivet? Tryck på hjärtat, så finns receptet här till nästa gång.</p>
              <a class="button primary" href="receptarkiv.html">Till receptarkivet <i class="fas fa-arrow-up-right" aria-hidden="true"></i></a>
            </div>
          </div>
        </section>
      </div>

      <div class="book-signed-out when-signed-out">
        <p><a class="button primary" href="logga-in.html" data-account-link>Logga in</a></p>
        <p class="meta">Recept du har sparat utan konto finns under <a href="receptarkiv.html?vy=sparade">Sparat i receptarkivet</a>.</p>
      </div>
      <noscript><p class="meta">Receptboken behöver JavaScript.</p></noscript>
    </section>
  </main>
