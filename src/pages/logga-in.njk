---js
// logga-in.html: sign in, create an account, sign in with a code sent by text, ask for a new password. Built only when the site has
// accounts (accountPages in eleventy.config.js). src/js/auth-forms.js does the work; HANDOFF.md, "Konton och receptbok".
// ?till=<path> is where to go afterwards, ?lage=skapa opens "Skapa konto".
const layout = 'layouts/base.njk';
const title = 'Logga in';
const description = 'Logga in eller skapa ett konto för att samla dina recept i en egen receptsamling.';
const noindex = true;
const modules = ['auth-forms.js'];
const permalink = 'logga-in.html';
---
  <main id="main" class="wrap account-page account-auth" data-auth-page="login">
    <section class="auth-card" aria-labelledby="auth-title">
      {#- The title follows what the card shows: auth-forms.js sets it from the mode, or from the
          part's data-title ("Glömt lösenordet?", "Kolla din mejl."). #}
      <h1 id="auth-title" class="auth-title" tabindex="-1"><span class="marker" data-auth-title>Logga in.</span></h1>

      {#- First the ways to sign in, all as buttons. Google leaves for Google's page; the mobile number
          and e-mail open parts of their own below. Facebook, when it comes, goes after Google. #}
      <div class="auth-part" data-auth-main>
        <p class="auth-intro">Med ett konto får du en egen receptsamling, som följer med mellan mobilen och datorn.</p>
        <div class="auth-providers">
          <button class="button account-wide" type="button" data-google><img src="assets/icons/google.svg" alt="" width="20" height="20">Fortsätt med Google</button>
          <button class="button account-wide" type="button" data-phone-open><i class="fas fa-mobile-screen-button" aria-hidden="true"></i>Fortsätt med mobilnummer</button>
          <button class="button account-wide" type="button" data-email-open><i class="fas fa-envelope" aria-hidden="true"></i>Fortsätt med e-post</button>
        </div>
        <p class="account-error" role="alert" data-auth-error hidden></p>
        <p class="auth-switch">
          <span data-only="logga">Har du inget konto? <a href="logga-in.html?lage=skapa" data-mode="skapa">Skapa konto</a></span>
          <span data-only="skapa" hidden>Har du redan ett konto? <a href="logga-in.html" data-mode="logga">Logga in</a></span>
        </p>
      </div>

      {#- E-mail and password. The title follows the mode (auth-forms.js). The switch between the modes
          is here too, so someone without an account doesn't have to go back for it. #}
      <div class="auth-part" data-email-part hidden>
        <form class="account-form" data-auth-form novalidate>
          <div class="account-field" data-only="skapa" hidden>
            <label for="auth-name">Namn <span class="account-optional">(valfritt)</span></label>
            <input id="auth-name" name="name" type="text" autocomplete="name" maxlength="80">
          </div>
          <div class="account-field">
            <label for="auth-email">E-postadress</label>
            <input id="auth-email" name="email" type="email" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" required>
          </div>
          <div class="account-field">
            <label for="auth-password">Lösenord</label>
            <input id="auth-password" name="password" type="password" autocomplete="current-password" required aria-describedby="auth-password-hint">
            <div class="auth-field-foot">
              <p id="auth-password-hint" class="account-hint" data-only="skapa" hidden>Minst 8 tecken.</p>
              <button class="text-button" type="button" data-forgot data-only="logga">Glömt lösenordet?</button>
            </div>
          </div>
          <p class="account-error" role="alert" data-email-error hidden></p>
          <button class="button primary account-wide" type="submit" data-auth-submit>Logga in</button>
          <p class="account-hint" data-only="skapa" hidden>Vi sparar din e-postadress, ditt namn och det du lägger i receptsamlingen. <a href="integritet.html">Så hanterar vi dina uppgifter</a>.</p>
          <p class="auth-back"><button class="text-button" type="button" data-email-back><i class="fas fa-arrow-left" aria-hidden="true"></i> Till inloggningen</button></p>
        </form>
        <p class="auth-switch">
          <span data-only="logga">Har du inget konto? <a href="logga-in.html?lage=skapa" data-mode="skapa">Skapa konto</a></span>
          <span data-only="skapa" hidden>Har du redan ett konto? <a href="logga-in.html" data-mode="logga">Logga in</a></span>
        </p>
      </div>

      <form class="account-form auth-part" data-reset-form data-title="Glömt lösenordet?" novalidate hidden>
        <p class="auth-lead">Skriv din e-postadress, så skickar vi en länk där du väljer ett nytt lösenord.</p>
        <div class="account-field">
          <label for="reset-email">E-postadress</label>
          <input id="reset-email" name="email" type="email" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" required>
        </div>
        <p class="account-error" role="alert" data-reset-error hidden></p>
        <p class="account-status auth-note" role="status" data-reset-status></p>
        <button class="button primary account-wide" type="submit">Skicka länk</button>
        <p class="auth-back"><button class="text-button" type="button" data-reset-back><i class="fas fa-arrow-left" aria-hidden="true"></i> Till inloggningen</button></p>
      </form>

      {#- Sign-in by text message: the number, then the code. A number without an account gets one, so
          both modes use it; the title follows the mode (auth-forms.js). #}
      <form class="account-form auth-part" data-phone-form novalidate hidden>
        <p class="auth-lead">Skriv ditt mobilnummer, så skickar vi en kod i ett sms.</p>
        <div class="account-field" data-only="skapa" hidden>
          <label for="auth-phone-name">Namn <span class="account-optional">(valfritt)</span></label>
          <input id="auth-phone-name" name="name" type="text" autocomplete="name" maxlength="80">
        </div>
        <div class="account-field">
          <label for="auth-phone">Mobilnummer</label>
          <input id="auth-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required aria-describedby="auth-phone-hint">
          <p id="auth-phone-hint" class="account-hint">Ett svenskt mobilnummer, t.ex. 070-123 45 67.</p>
        </div>
        <p class="account-error" role="alert" data-phone-error hidden></p>
        <button class="button primary account-wide" type="submit">Skicka kod</button>
        <p class="account-hint" data-only="skapa" hidden>Vi sparar ditt mobilnummer, ditt namn och det du lägger i receptsamlingen. <a href="integritet.html">Så hanterar vi dina uppgifter</a>.</p>
        <p class="auth-back"><button class="text-button" type="button" data-phone-back><i class="fas fa-arrow-left" aria-hidden="true"></i> Till inloggningen</button></p>
      </form>

      <form class="account-form auth-part" data-code-form data-title="Kolla din mobil." novalidate hidden>
        <p class="auth-lead" role="status" data-code-text></p>
        <div class="account-field">
          <label for="auth-code">Kod</label>
          <input id="auth-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="12" required>
        </div>
        <p class="account-error" role="alert" data-code-error hidden></p>
        <button class="button primary account-wide" type="submit">Logga in</button>
        <p class="account-hint">Kom inget sms? Vänta en minut och skicka koden igen.</p>
        <button class="button account-wide" type="button" data-code-resend>Skicka koden igen</button>
        <p class="auth-back"><button class="text-button" type="button" data-code-back><i class="fas fa-arrow-left" aria-hidden="true"></i> Byt nummer</button></p>
      </form>

      <div class="account-sent auth-part" data-auth-sent data-title="Kolla din mejl." hidden>
        <p class="auth-lead" role="status" data-sent-text></p>
        <p class="account-hint">Kom inget mejl? Titta i skräpposten, eller skicka länken igen.</p>
        <p class="account-error" role="alert" data-sent-error hidden></p>
        <button class="button account-wide" type="button" data-resend>Skicka igen</button>
        <p class="auth-back"><button class="text-button" type="button" data-sent-back><i class="fas fa-arrow-left" aria-hidden="true"></i> Till inloggningen</button></p>
      </div>

      <noscript><p class="account-error">Inloggningen behöver JavaScript.</p></noscript>
    </section>
  </main>
