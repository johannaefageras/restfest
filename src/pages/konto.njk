---js
// konto.html: a signed-in visitor's sign-in details: change or add the email address, the mobile
// number and the password, sign out, delete the account. Built only when the site has accounts (accountPages in eleventy.config.js).
// src/js/profile.js; HANDOFF.md, "Konton och receptbok".
const layout = 'layouts/base.njk';
const title = 'Konto';
const description = 'Din inloggning hos Ofta bra efter.';
const noindex = true;
const modules = ['profile.js'];
const permalink = 'konto.html';
---
  <main id="main" class="wrap account-page account-dashboard" data-profile-page="konto">
    <section class="account-card" aria-labelledby="account-title">
      <header class="greeting archive-greeting">
        <div>
          <h1 id="account-title"><span class="marker">Konto.</span></h1>
          <p class="greeting-intro">Här tar du hand om din inloggning, byter lösenord och håller dina uppgifter uppdaterade.</p>
        </div>
        <div class="greeting-aside" aria-hidden="true">
          <div class="doodle-lineup"><img src="assets/icons/gear.svg" alt="" width="60" height="60"></div>
        </div>
      </header>
      {%- set current = 'konto' %}
      {% include "account-nav.njk" %}
      <p class="account-status" role="status" data-account-wait>Hämtar ditt konto …</p>

      <div class="account-settings-grid" data-account-sections hidden>
        <section class="account-section pantry-panel account-login-summary" aria-labelledby="account-login-title">
          <span class="account-login-icon"><img src="assets/icons/user-profile.svg" alt="" width="32" height="32"></span>
          <div>
            <h2 id="account-login-title">Inloggad som</h2>
            <p class="account-email" data-account-email></p>
            <p class="account-hint" data-account-methods></p>
          </div>
        </section>

        <section class="account-section account-credentials add-card" aria-labelledby="account-email-title">
          {#- "Lägg till e-postadress" for an account made with a mobile number (profile.js). #}
          <h2 id="account-email-title" data-email-title>Byt e-postadress</h2>
          <div class="account-section-copy">
            <p class="account-panel-intro" data-email-intro>En ny adress? Vi skickar en länk så att du kan bekräfta bytet.</p>
          </div>
          <form class="account-form" data-email-form novalidate>
            <div class="account-field">
              <label for="account-new-email">Ny e-postadress</label>
              <input id="account-new-email" name="email" type="email" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" required>
            </div>
            <p class="account-error" role="alert" data-email-error hidden></p>
            <p class="account-status" role="status" data-email-status></p>
            <div class="account-submit"><button class="button" type="submit" data-email-submit>Byt e-postadress</button></div>
          </form>
        </section>

        {#- Hidden for an account without an email address: the password goes with the address. #}
        <section class="account-section account-credentials photo-card" aria-labelledby="account-password-title" data-password-section>
          <h2 id="account-password-title" data-password-title>Byt lösenord</h2>
          <div class="account-section-copy">
            <p class="account-panel-intro" data-password-intro hidden>Med ett lösenord kan du också logga in med din e-postadress.</p>
          </div>
          <form class="account-form" data-password-change novalidate>
            <div class="account-field">
              <label for="account-new-password">Nytt lösenord <span class="account-optional">(minst 8 tecken)</span></label>
              <input id="account-new-password" name="password" type="password" autocomplete="new-password" required>
            </div>
            <p class="account-error" role="alert" data-password-error hidden></p>
            <p class="account-status" role="status" data-password-status></p>
            <div class="account-submit"><button class="button" type="submit">Spara lösenordet</button></div>
          </form>
        </section>

        {#- Adding or changing the number takes a code sent to it: the code field shows once it is sent. #}
        <section class="account-section account-credentials account-phone pantry-panel" aria-labelledby="account-phone-title">
          <h2 id="account-phone-title" data-phone-title>Lägg till mobilnummer</h2>
          <div class="account-section-copy">
            <p class="account-panel-intro" data-phone-intro>Med ett mobilnummer kan du också logga in med en kod per sms.</p>
          </div>
          <form class="account-form" data-phone-change novalidate>
            <div class="account-field">
              <label for="account-new-phone">Mobilnummer</label>
              <input id="account-new-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required>
            </div>
            <div class="account-field" data-phone-code-field hidden>
              <label for="account-phone-code">Koden från sms:et</label>
              <input id="account-phone-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="12">
              <div class="auth-field-foot"><button class="text-button" type="button" data-phone-resend>Skicka en ny kod</button></div>
            </div>
            <p class="account-error" role="alert" data-phone-error hidden></p>
            <p class="account-status" role="status" data-phone-status></p>
            <div class="account-submit"><button class="button" type="submit" data-phone-submit>Skicka kod</button></div>
          </form>
        </section>

        <section class="account-section pantry-panel account-action-row" aria-labelledby="account-out-title">
          <div>
            <h2 id="account-out-title">Klar för den här gången?</h2>
            <p class="account-hint">Logga ut på den här enheten. Din receptsamling finns kvar till nästa gång.</p>
          </div>
          <div class="account-submit"><button class="button" type="button" data-sign-out>Logga ut</button></div>
        </section>

        <section class="account-section pantry-panel account-action-row" aria-labelledby="account-delete-title">
          <div>
            <h2 id="account-delete-title">Ta bort kontot</h2>
            <p class="account-hint">Kontot, din profil och din receptsamling tas bort. Det går inte att ångra.</p>
          </div>
          <div class="account-submit"><button class="button account-danger" type="button" data-delete-open aria-haspopup="dialog">Ta bort kontot..</button></div>
        </section>
      </div>
      <noscript><p class="account-error">Sidan behöver JavaScript.</p></noscript>
    </section>

    <dialog id="delete-dialog" class="account-dialog" aria-labelledby="delete-title">
      <div class="dialog-main">
        <h2 id="delete-title">Ta bort kontot?</h2>
        <p>Kontot, din profil och din receptsamling tas bort. Det går inte att ångra. Recept du har hittat på ligger kvar på sina sidor, men inte under ditt namn.</p>
        <p class="account-error" role="alert" data-delete-error hidden></p>
        <div class="account-dialog-buttons">
          <button class="button" type="button" data-delete-cancel autofocus>Avbryt</button>
          <button class="button primary account-danger" type="button" data-delete-confirm>Ta bort kontot</button>
        </div>
      </div>
    </dialog>
  </main>
