---
layout: layouts/base.njk
permalink: receptarkiv.html
title: Receptarkivet
description: Hitta något att laga i receptarkivet på Ofta bra efter och samla dina favoriter.
archivePicker: true
---
{%- set sortOptions = [
  {value: 'default', label: 'Standard', icon: 'sort-default'},
  {value: 'match', label: 'Bäst matchning', icon: 'sort-best'},
  {value: 'title', label: 'A–Z', icon: 'sort-ascending'},
  {value: 'title-descending', label: 'Z–A', icon: 'sort-descending'},
  {value: 'newest', label: 'Nyast först', icon: 'sort-newest'},
  {value: 'oldest', label: 'Äldst först', icon: 'sort-oldest'}
] -%}
  <main id="main" class="wrap archive-page">
    <section class="greeting archive-greeting" aria-labelledby="archive-title">
      <div>
        <a class="text-button archive-back" href="./"><i class="fas fa-arrow-left" aria-hidden="true"></i> Till startsidan</a>
        <h1 id="archive-title"><span class="marker">Receptarkivet.</span></h1>
        <p class="greeting-intro">Bläddra bland middagar, fika, drycker och skafferirecept, och spara dina favoriter. Du kan också <a href="typ/mat.html">gå direkt till en kategori</a>. Hemmaspa, städning, godis till husdjuren och odling finns under <a href="mer-an-mat.html">Mer än mat</a>.</p>
      </div>
      <div class="greeting-aside" aria-hidden="true">
        <div class="doodle-lineup">
          <img id="archive-category-icon" src="assets/icons/recipe-archive.svg" alt="" width="60" height="60">
        </div>
      </div>
    </section>

    <div class="archive-workspace">
      <section class="recipes-section archive-recipes" aria-labelledby="recipes-heading">
        <h2 id="recipes-heading" class="eyebrow">Hitta ett recept</h2>
        <div class="archive-controls">
          <div class="archive-search">
            <label for="recipe-search">Sök på namn, ingrediens eller tagg</label>
            <div class="archive-search-field">
              <img src="assets/icons/magnifying-glass.svg" alt="" width="23" height="23">
              <input id="recipe-search" type="search" placeholder="T.ex. pasta, spenat eller kikärter" autocomplete="off">
            </div>
          </div>
          <details id="archive-filter-panel" class="archive-filter-panel">
            <summary>
              <img src="assets/icons/filter-funnel.svg" alt="" width="18" height="18">
              <span>Filter</span>
              <span id="archive-filter-count" class="archive-filter-count" hidden>0</span>
              <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </summary>
            <div class="archive-filter-panel-body">
              <div class="archive-category">
                <p class="filter-label" id="meal-filters-label">Kategori</p>
                <details id="meal-picker" class="meal-picker">
                  <summary aria-labelledby="meal-filters-label meal-filter-value">
                    <img src="assets/icons/categories.svg" alt="" width="24" height="24">
                    <span id="meal-filter-value">Alla kategorier</span>
                    <i class="fas fa-chevron-down" aria-hidden="true"></i>
                  </summary>
                  <div id="meal-filters" class="meal-picker-options" role="group" aria-labelledby="meal-filters-label"></div>
                </details>
              </div>
              <div class="archive-filters">
                <div class="archive-quick-filters" role="group" aria-label="Snabbfilter">
                  <button id="quick-filter" class="food-filter" type="button" aria-pressed="false"><img src="assets/icons/stopwatch.svg" alt="" width="22" height="22">Under 20 min</button>
                  <button id="saved-filter" class="food-filter" type="button" aria-pressed="false">
                    <img src="assets/icons/heart.svg" alt="" width="22" height="22"> Sparade recept
                  </button>
                  <button id="meat-free-filter" class="food-filter" type="button" aria-pressed="false">
                    <img src="assets/icons/leaf.svg" alt="" width="22" height="22"> Utan kött
                  </button>
                  <button id="budget-filter" class="food-filter" type="button" aria-pressed="false">
                    <img src="assets/icons/money-bag.svg" alt="" width="22" height="22"> Budgetvänligt
                  </button>
                </div>
                <details class="archive-advanced-filters">
                  <summary>
                    <img src="assets/icons/filter-funnel.svg" alt="" width="18" height="18">
                    <span>Fler filter</span>
                    <span id="advanced-filter-state" class="archive-filter-count" hidden>0</span>
                    <i class="fas fa-chevron-down" aria-hidden="true"></i>
                  </summary>
                  <div class="archive-advanced-filter-groups">
                    <div class="archive-diet-group">
                      <p class="filter-label" id="diet-filters-label">Kost</p>
                      <div id="diet-filters" class="archive-diet-filters" role="group" aria-labelledby="diet-filters-label"></div>
                    </div>
                    <div>
                      <p class="filter-label" id="food-filters-label">Råvarutyp</p>
                      <div id="food-filters" class="food-filters" role="group" aria-labelledby="food-filters-label"></div>
                    </div>
                    <div class="archive-tag-filter">
                      <label for="recipe-tag-search" class="filter-label">Taggar</label>
                      <div class="tag-picker">
                        <div class="tag-picker-field">
                          <img src="assets/icons/magnifying-glass.svg" alt="" width="21" height="21">
                          <input id="recipe-tag-search" type="text" role="combobox" aria-autocomplete="list"
                            aria-controls="recipe-tag-suggestions" aria-expanded="false" aria-describedby="recipe-tag-hint"
                            autocomplete="off" spellcheck="false" placeholder="Sök taggar, t.ex. Italienskt">
                        </div>
                        <ul id="recipe-tag-suggestions" class="tag-picker-suggestions" role="listbox" aria-label="Taggförslag" hidden></ul>
                        <p class="tag-picker-empty" role="status"></p>
                      </div>
                      <p id="recipe-tag-hint">Recepten måste matcha alla valda taggar.</p>
                    </div>
                  </div>
                </details>
              </div>
            </div>
          </details>
        </div>
        <div class="archive-results-row">
          <p id="archive-results" class="meta archive-results" role="status"></p>
          {#- app.js shows "Bäst matchning" when the fridge list has an ingredient it can match. #}
          <div class="archive-sort">
            <span class="sr-only" id="archive-sort-label">Sortera</span>
            <details id="archive-sort" class="meal-picker">
              <summary aria-labelledby="archive-sort-label archive-sort-value">
                <img src="assets/icons/sort-default.svg" alt="" width="24" height="24">
                <span id="archive-sort-value">Standard</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
              </summary>
              <div class="meal-picker-options" role="group" aria-labelledby="archive-sort-label">
                {%- for option in sortOptions %}
                <button type="button" tabindex="-1" data-value="{{ option.value }}" aria-pressed="{{ option.value == 'default' }}"{% if option.value == 'match' %} id="archive-sort-match" hidden{% endif %}><img src="assets/icons/{{ option.icon }}.svg" alt="" width="24" height="24"><span>{{ option.label }}</span><img src="assets/icons/check-mark.svg" alt="" width="16" height="16"></button>
                {%- endfor %}
              </div>
            </details>
          </div>
        </div>
        <p id="archive-elsewhere" class="meta archive-elsewhere" hidden></p>
        <div id="recipe-grid" class="recipe-grid"></div>
        {#- pagedGrid() in js/load-more.js builds this same block under the other long grids: change the two together. #}
        <div id="archive-more" class="archive-more" hidden>
          <div id="archive-preview" class="recipe-grid archive-preview" aria-hidden="true" inert></div>
          <div class="archive-more-controls">
            <button id="load-more-recipes" class="text-button" type="button" aria-controls="recipe-grid">Visa fler recept</button>
            <p id="archive-page-count" class="archive-page-count"></p>
          </div>
        </div>
        <div id="empty-saved" class="empty-saved" hidden>
          <img src="assets/icons/heart.svg" width="52" height="52" alt="">
          <h3>Inga sparade recept än.</h3>
          <p>Tryck på hjärtat vid ett recept så hittar du det här.</p>
          <button id="show-all" class="text-button">Visa alla recept <i class="fas fa-arrow-up-right" aria-hidden="true"></i></button>
        </div>
        <div id="empty-search" class="empty-saved" hidden>
          <img src="assets/icons/book-search.svg" width="52" height="52" alt="">
          <h3>Inga träffar.</h3>
          <p>Prova en annan ingrediens eller rensa filtren.</p>
          <button id="clear-recipe-filters" class="text-button">Rensa filtren</button>
        </div>
      </section>
    </div>
  </main>
