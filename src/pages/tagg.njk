// One page per tag, e.g. tagg/veganskt.html
// The pages come from collections.recipeTags (eleventy.config.js, lib/recipes.js); the layout is _includes/layouts/listing.njk.
const layout = 'layouts/listing.njk';
const base = '../';
const pagination = {data: 'collections.recipeTags', size: 1, alias: 'listing', addAllPagesToCollections: true};
const permalink = data => data.listing.path;
const eleventyComputed = {
  title: data => data.listing.label,
  description: data => data.listing.description
};
