---js
// profil.html: a signed-in visitor's name and preferences (diets, foods they don't eat, portions),
// which Claude follows when it writes them a new recipe. Built only when the site has accounts
// (accountPages in eleventy.config.js). src/js/profile.js; HANDOFF.md, "Konton och receptbok".
const layout = 'layouts/base.njk';
const title = 'Profil · Ofta bra efter';
const description = 'Ditt namn och dina preferenser hos Ofta bra efter.';
const noindex = true;
const modules = ['profile.js'];
const permalink = 'profil.html';
---
  <main id="main" class="wrap account-page account-dashboard" data-profile-page="profil">
    <section class="account-card" aria-labelledby="profile-title">
      <header class="greeting archive-greeting">
        <div>
          <h1 id="profile-title"><span class="marker">Profil.</span></h1>
          <p class="greeting-intro">Lite om dig och hur du gillar att äta. Vi följer dina val när vi hittar på nya recept åt dig.</p>
        </div>
        <div class="greeting-aside" aria-hidden="true">
          <div class="doodle-lineup"><img src="assets/icons/user-profile-purple.svg" alt="" width="60" height="60"></div>
        </div>
      </header>
      {%- set current = 'profil' %}
      {% include "account-nav.njk" %}
      <p class="account-status" role="status" data-profile-wait>Hämtar din profil …</p>

      <form class="account-form profile-layout" data-profile-form novalidate hidden>
        <div class="profile-main">
          <section class="account-panel add-card" aria-labelledby="profile-about-title">
            <h2 id="profile-about-title">Lite om dig</h2>
            <div class="account-field">
              <label for="profile-name">Namn <span class="account-optional">(valfritt)</span></label>
              <input id="profile-name" name="display_name" type="text" autocomplete="name" maxlength="80" placeholder="Vad heter du?">
            </div>
          </section>

          <section class="account-panel pantry-panel">
            <fieldset class="account-group" aria-describedby="profile-diets-hint">
              <legend>Kost</legend>
              <p class="account-panel-intro" id="profile-diets-hint">Välj det som passar dig. Du kan kryssa i flera.</p>
              <div class="account-checks" data-diets></div>
              <p class="account-hint">Veganskt räknas också som vegetariskt, mjölkfritt och äggfritt.</p>
            </fieldset>
          </section>

          <section class="account-panel pantry-panel" aria-labelledby="profile-foods-title">
            <h2 id="profile-foods-title">Det här hoppar du över</h2>
            <div class="account-field">
              <label for="profile-avoid">Råvaror du inte äter</label>
              <div class="account-add">
                <input id="profile-avoid" type="text" maxlength="80" autocomplete="off" enterkeyhint="done" aria-describedby="profile-avoid-hint" placeholder="Till exempel koriander">
                <button class="button" type="button" data-avoid-add>Lägg till</button>
              </div>
              <p id="profile-avoid-hint" class="account-hint">Lägg till en råvara i taget, så lämnar vi den utanför nya recept.</p>
              <p class="account-error" role="alert" data-avoid-error hidden></p>
              <ul class="account-chips" data-avoid-list aria-label="Råvaror du inte äter"></ul>
            </div>
          </section>
        </div>

        <div class="profile-aside">
          <section class="account-panel photo-card" aria-labelledby="profile-portions-title">
            <img class="account-panel-art" src="assets/illustrations/ramen-bowl.svg" alt="" width="72" height="72">
            <h2 id="profile-portions-title">Hur många till middag?</h2>
            <p class="account-panel-intro">En portion till dig, eller mat till hela gänget?</p>
            <div class="account-field">
              <label for="profile-servings">Portioner</label>
              <select id="profile-servings" name="servings" aria-describedby="profile-servings-hint">
                <option value="">Låt receptet bestämma</option>
                {%- for count in range(1, 13) %}
                <option value="{{ count }}">{{ count }}</option>
                {%- endfor %}
              </select>
              <p id="profile-servings-hint" class="account-hint">Så många brukar du laga till.</p>
            </div>
          </section>
          <aside class="account-note">
            <img src="assets/illustrations/light-bulb.svg" alt="" width="36" height="36">
            <p>Ändrat smak? Du kan alltid komma tillbaka och ändra dina val.</p>
          </aside>
        </div>

        <p class="account-error" role="alert" data-profile-error hidden></p>
        <div class="account-submit profile-save">
          <button class="button primary" type="submit">Spara profilen <i class="fas fa-check" aria-hidden="true"></i></button>
          <p class="account-status" role="status" data-profile-saved></p>
        </div>
      </form>
      <noscript><p class="account-error">Sidan behöver JavaScript.</p></noscript>
    </section>
  </main>
